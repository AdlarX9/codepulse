# =============================================================================
# CODEPULSE CONFIGURATION
# =============================================================================

# Environment
ENV=production
DOMAIN=your-domain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=codepulse
DB_PASSWORD=your_secure_database_password
DB_NAME=codepulse

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis for caching and sessions
REDIS_URL=redis:6379
REDIS_PASSWORD=your_secure_redis_password

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Security
DOWNLOAD_IP_SALT=your_random_salt_for_ip_hashing

# =============================================================================
# SSL CERTIFICATES
# =============================================================================

# Put your SSL certificates in ./certs/ directory:
# - fullchain.pem (certificate + intermediate)
# - privkey.pem (private key)

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Email (for notifications - optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Server
PORT=8080
ENVIRONMENT=production

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://your-domain.com

# =============================================================================
# GITHUB APP INTEGRATION
# =============================================================================

# GitHub App credentials for PR checks and webhooks
# Create a GitHub App at: https://github.com/settings/apps/new
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour private key here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: GitHub OAuth for user authentication
# GITHUB_CLIENT_ID=your_github_oauth_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# =============================================================================
# STRIPE BILLING
# =============================================================================

# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs for each plan
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_TEAM=price_your_team_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# =============================================================================
# SLACK INTEGRATION
# =============================================================================

# Slack App credentials (create at https://api.slack.com/apps)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=https://your-domain.com/api/integrations/slack/callback

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Postmark (recommended) or AWS SES
POSTMARK_TOKEN=your_postmark_server_token
EMAIL_FROM_ADDR=noreply@codepulse.dev

# Alternative: AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your_access_key
# AWS_SES_SECRET_ACCESS_KEY=your_secret_key
