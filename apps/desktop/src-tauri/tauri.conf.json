{
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"devPath": "http://localhost:1420",
		"distDir": "../dist",
		"withGlobalTauri": false
	},
	"package": {
		"productName": "CodePulse",
		"version": "1.0.0"
	},
	"tauri": {
		"allowlist": {
			"all": false,
			"shell": {
				"all": false,
				"open": true
			},
			"fs": {
				"all": false,
				"readFile": true,
				"readDir": true,
				"scope": ["$APPDATA/**", "$HOME/**"]
			},
			"dialog": {
				"all": false,
				"open": true,
				"save": true
			},
			"path": {
				"all": true
			}
		},
		"bundle": {
			"active": true,
			"targets": "all",
			"identifier": "com.codepulse.app",
			"icon": [
				"icons/32x32.png",
				"icons/128x128.png",
				"icons/128x128@2x.png",
				"icons/icon.icns",
				"icons/icon.ico"
			],
			"resources": [],
			"externalBin": [],
			"copyright": "Copyright © 2024 CodePulse",
			"category": "DeveloperTool",
			"shortDescription": "Analyze your codebase",
			"longDescription": "Beautiful, privacy-first code analysis tool for developers",
			"macOS": {
				"entitlements": null,
				"exceptionDomain": "",
				"frameworks": [],
				"providerShortName": null,
				"signingIdentity": null
			},
			"windows": {
				"certificateThumbprint": null,
				"digestAlgorithm": "sha256",
				"timestampUrl": ""
			}
		},
		"security": {
			"csp": null
		},
		"windows": [
			{
				"fullscreen": false,
				"resizable": true,
				"title": "CodePulse",
				"width": 1400,
				"height": 900,
				"minWidth": 800,
				"minHeight": 600
			}
		]
	}
}
