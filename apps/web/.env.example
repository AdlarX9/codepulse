# Public
NEXT_PUBLIC_SITE_URL=https://codepulse.app

# PostgreSQL Database (for Next.js API routes)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codepulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Download tracking
DOWNLOAD_IP_SALT=change_me_long_random_string_for_production

# GitHub (for asset resolution)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=AdlarX9/code-pulse

# Admin access
NEXT_ADMIN_USER=admin
NEXT_ADMIN_PASS=supersecret
