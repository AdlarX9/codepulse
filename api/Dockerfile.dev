FROM golang:1.24-alpine AS dev

# Install dependencies for hot reload and development tools
RUN apk add --no-cache git curl

# Install Air for hot reload
RUN go install github.com/cosmtrek/air@v1.40.0

# Install migrate for database migrations
RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@latest

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Expose port
EXPOSE 8080

# Command to run with hot reload
CMD ["air", "-c", ".air.toml"]