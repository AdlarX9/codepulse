{
	"name": "codepulse",
	"version": "1.0.0",
	"private": true,
	"description": "CodePulse - Analyze your codebase with style",
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "pnpm --filter web dev",
		"dev:desktop": "pnpm --filter desktop dev",
		"build": "turbo run build",
		"build:web": "pnpm --filter web build",
		"build:desktop": "pnpm --filter desktop build",
		"lint": "turbo run lint",
		"clean": "turbo run clean && rm -rf node_modules",
		"release:tag": "node scripts/release-tag.js",
		"format": "npx prettier --write . --log-level debug"
	},
	"devDependencies": {
		"turbo": "^2.0.0",
		"prettier": "^3.3.0",
		"@types/node": "^20.14.0"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.5.0"
}
