{
	"name": "codepulse",
	"version": "1.0.0",
	"private": true,
	"description": "CodePulse - Analyze your codebase with style",
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "pnpm --filter web dev",
		"dev:desktop": "pnpm --filter desktop dev",
		"build": "turbo run build",
		"build:web": "pnpm --filter web build",
		"build:desktop": "pnpm --filter desktop build",
		"lint": "turbo run lint",
		"clean": "turbo run clean && rm -rf node_modules",
		"release:tag": "node scripts/release-tag.js",
		"format": "npx prettier --write . --log-level debug"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"autoprefixer": "^10.4.27",
		"baseline-browser-mapping": "^2.10.13",
		"postcss": "^8.5.8",
		"prettier": "^3.8.1",
		"tailwindcss": "^4.2.2",
		"turbo": "^2.9.3"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@10.32.1"
}
