FROM node:22-alpine

# Install pnpm
RUN npm install -g pnpm

# Install system dependencies for native modules
RUN apk add --no-cache \
	python3 \
	build-base \
	pkgconf \
	cairo-dev \
	pango-dev \
	libjpeg-turbo-dev \
	giflib-dev \
	pixman-dev \
	freetype-dev \
	fontconfig-dev && \
	ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app


# Copy source code (now much smaller due to .dockerignore)
COPY . /app/apps/web/

# Set working directory for the web app
WORKDIR /app/apps/web

# Install dependencies
RUN pnpm install

# Expose port
EXPOSE 3000

# Set environment for development
ENV NODE_ENV=development
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Command to run with hot reload
CMD ["pnpm", "dev", "-p", "3000", "-H", "0.0.0.0"]